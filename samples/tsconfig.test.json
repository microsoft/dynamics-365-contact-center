{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-test",
    "baseUrl": ".",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "paths": {
      "@ccaas/CCaaSEmbedSDK": ["./ICCaaSEmbedSDK/typings/CCaaSEmbedSDK.d.ts"],
      "@ccaas/CCaaSEmbedSDK/enums": ["./ICCaaSEmbedSDK/typings/enums.ts"],
      "@ccaas/ictiinterface": ["./ICTIInterface/typings/ICTI.d.ts"],
      "@ccaas/core": ["./core/src/index.ts"]
    }
  },
  "include": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/src/**/*.ts",
    "ICCaaSEmbedSDK/typings/**/*.ts",
    "ICTIInterface/typings/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-test"]
}
