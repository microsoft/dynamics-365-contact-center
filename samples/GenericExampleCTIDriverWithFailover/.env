# ── CCaaS Widget Endpoints ────────────────────────────────────────────
# Primary endpoint 
REACT_APP_PRIMARY_URL=https://<caas-embed-url>?dynamicsUrl=<org>&useCustomCTI=1

# Fallback endpoint
REACT_APP_FALLBACK_URL=https://go.microsoft.com/fwlink/?linkid=2353518dynamicsUrl=<org>&useCustomCTI=1

# ── Failover tuning ──────────────────────────────────────────────────
REACT_APP_PROBE_TIMEOUT_MS=10000
REACT_APP_REPROBE_INTERVAL_MS=60000
