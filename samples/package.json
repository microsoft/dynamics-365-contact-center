{
  "name": "@ccaas/samples",
  "version": "1.0.0",
  "private": true,
  "description": "D365 Contact Center CTI Driver Samples and Tests",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "build:all": "npm run build --workspaces --if-present",
    "clean:all": "npm run clean --workspaces --if-present"
  },
  "workspaces": [
    "core",
    "SFExampleCTIDriver",
    "GenericExampleCTIDriver"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  },
  "keywords": [
    "d365",
    "dynamics365",
    "contact-center",
    "ccaas",
    "cti",
    "testing"
  ],
  "author": "Microsoft Corporation",
  "license": "MIT"
}
